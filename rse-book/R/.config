DATA_DIR = "RSE_survey_2026_data"

NORDIC_COUNTRIES <- c(
  "Finland", "Norway", "Sweden", "Denmark", "Iceland", "Estonia"
)

# Primary country scope for chapter analyses (landing page stays Nordic).
# Examples:
#   FILTER = NORDIC_COUNTRIES
#   FILTER = "Germany"
#   FILTER = "South Africa"
FILTER = NORDIC_COUNTRIES

# Extra named groups for the "Between Countries" section.
# The primary FILTER group is always included first; groups that match
# FILTER exactly are skipped. Examples:
#   FILTER_COMPARE = list(Germany = "Germany", Netherlands = "Netherlands")
#   FILTER_COMPARE = list(
#     Nordics = NORDIC_COUNTRIES,
#     Germany = "Germany",
#     Netherlands = "Netherlands"
#   )
FILTER_COMPARE = list(
  Nordics = NORDIC_COUNTRIES,
  Germany = "Germany",
  Netherlands = "Netherlands"
)
